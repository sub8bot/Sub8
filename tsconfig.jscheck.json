// Non-blocking JS baseline: the same strict bar as packages/*, pointed at the
// legacy .mjs/.js tree so we can watch the gap close as code migrates.
//
//   npm run typecheck:js
//
// This config is deliberately NOT part of `npm run check`. It reports; it does
// not gate. Nothing here is silenced with @ts-nocheck or `any` -- the number it
// prints is the honest distance between today's JS and the packages/* bar.
//
// Baseline on 2026-08-25 (~46k lines of .mjs/.js):
//   5,788 errors in 141 files at the full packages/* bar
//   ~960 of those survive with `strict` off, i.e. they are structural
//   (TS2339 property-does-not-exist and friends), not just missing annotations.
// After the six-package extraction (wakes, skills, choice, shell-exec,
// harness-auth, control) the same run reports 5,722 errors in 134 files: seven
// fewer files, because those seven .mjs left this tree for packages/*.
// After store, web-fetch and desk-ports: 5,418 errors in 118 files. Sixteen
// files left the count -- the ten .mjs those three packages took out of
// server/ and test/, plus the generated web/electron output the exclude list
// below stopped measuring.
// After grok-bot.js and tool.js became TypeScript: 5,234 errors in 116 files.
// Those two were 161 and 23 of the count above, and nothing else moved -- an
// A/B on one tree drops exactly those 184 lines and those 2 files. What is
// left under web/ is app.js, which is now the whole browser total.
// After app.js became TypeScript, web/ contributes nothing at all. Measured as
// an A/B on one tree, back to back, while a server/ conversion was in flight
// next door: 5,485 errors in 119 files with app.js in the count, 3,704 in 118
// with it excluded. The delta is exactly app.js's 1,781 lines and that one
// file; no other file's count moved by one. The absolute numbers read above
// the 5,234 line recorded here because server/*.mjs was mid-migration when
// they were taken -- the delta is the honest figure, not the total.
// Update these numbers when they move; do not make them move by silencing.
//
// The Electron main process and the extracted web/ modules are TypeScript as
// of 2026-08-25 and left this tree; their emitted JS is excluded below, so the
// count measures handwritten JavaScript only.
//
// A handful of the errors come from ../sub8-cloud: testing/checks/cloud.mjs
// statically imports the sibling repo, so tsc follows it into the program.
// That count drifts with whatever is checked out next door.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    // The legacy tree spans node and browser; check both against one lib set.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "main.mjs",
    "server/**/*.mjs",
    "server/**/*.js",
    "web/**/*.mjs",
    "web/**/*.js",
    "electron/**/*.mjs",
    "electron/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "test/**/*.mjs",
    "test/**/*.js",
    "testing/**/*.mjs",
    "testing/**/*.js",
    "tools/**/*.mjs",
    "tools/**/*.js"
  ],
  "exclude": [
    "node_modules",
    // Generated by tsc from electron/*.mts and web/*.mts/.ts. Checking machine
    // output against a "how far is the handwritten JS from the bar" measuring
    // stick would flatter the number and inflate the file count.
    "electron/main.mjs",
    "web/api-client.mjs",
    "web/app.js",
    "web/avatar.js",
    "web/brain-setup.mjs",
    "web/chat-merge.mjs",
    "web/cloud-place.mjs",
    "web/grok-bot.js",
    "web/harness-models.mjs",
    "web/icons.mjs",
    "web/markdown.js",
    "web/palette.js",
    "web/stream-bind.mjs",
    "web/tool.js",
    "cloud",
    "data",
    "packages",
    "build",
    "dist",
    "dist-mac",
    "dist-win",
    "dist-linux",
    "release",
    ".app"
  ]
}
